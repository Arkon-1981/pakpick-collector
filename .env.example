# Supabase 프로젝트 설정 (Supabase 대시보드 → Project Settings → API 에서 복사)
# 이 파일을 복사해서 .env 로 저장한 뒤 실제 값을 넣으세요.
# .env 파일은 절대 GitHub에 올라가지 않습니다 (.gitignore에 등록됨)

SUPABASE_URL=https://여기에-프로젝트-URL.supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에-service_role-키

# 원본 파일을 저장할 Storage 버킷 이름 (없으면 자동 생성됨)
RAW_BUCKET=raw-store-data

# 요청 사이 대기 시간(초) — 스토어 서버에 부담을 주지 않기 위함
REQUEST_DELAY_SECONDS=6.0
